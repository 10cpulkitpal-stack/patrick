GROQ_API_KEY=your-groq-api-key-here
SECRET_KEY=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# Email/password registration requires SMTP for account verification.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM="Patrick <your-email@gmail.com>"
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Optional account limit; defaults to 100 messages per UTC day.
DAILY_MESSAGE_LIMIT=100
