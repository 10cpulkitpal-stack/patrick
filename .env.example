GROQ_API_KEY=your-groq-api-key-here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_TEXT_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional; must also support image inputs.
GROQ_VISION_FALLBACK_MODEL=
GROQ_MAX_OUTPUT_TOKENS=4096
GEMINI_API_KEY=
# Optional default for new accounts; this is a current stable Gemini API model.
GEMINI_DEFAULT_MODEL=gemini-3.8-flash
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://patrick-c89f.onrender.com/auth/google/callback

# Email/password registration requires SMTP for account verification.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM="Patrick <your-email@gmail.com>"
PUBLIC_BASE_URL=https://patrick-c89f.onrender.com

# Optional account limit; defaults to 100 messages per UTC day.
DAILY_MESSAGE_LIMIT=100
